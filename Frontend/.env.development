# true = datos de prueba (src/mocks). false = backend real.
VITE_USE_MOCKS=false
# Rutas relativas: Vite las redirige con su proxy en desarrollo y el gateway en producción.
VITE_API_URL=/api
VITE_AUTH_API_URL=/api/v1
# Destinos reales del proxy de Vite (solo desarrollo, no se envían al navegador).
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_AUTH_PROXY_TARGET=http://localhost:3000
# reCAPTCHA v2 (checkbox). Esta es la site key pública de PRUEBA de Google.
# Reemplázala por la de tu dominio y activa RECAPTCHA_ENABLED + RECAPTCHA_SECRET en el backend.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
