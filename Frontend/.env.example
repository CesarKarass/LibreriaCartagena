# Copia este archivo a .env.development (o .env.production) y ajusta los valores.

# true = catálogo con datos de prueba. false = API real.
VITE_USE_MOCKS=false

# Rutas relativas: en desarrollo las resuelve el proxy de Vite;
# en producción deben quedar detrás del gateway o del mismo origen.
VITE_API_URL=/api
VITE_AUTH_API_URL=/api/v1

# Destinos del proxy de Vite (solo desarrollo).
# Si usas Docker: http://localhost:8083 (API C#) y http://localhost:3000 (login).
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_AUTH_PROXY_TARGET=http://localhost:3000
VITE_PROVEEDORES_PROXY_TARGET=http://localhost:5001

# reCAPTCHA v2 (checkbox). Sin esta clave el widget no se muestra.
# La siguiente es la site key pública de PRUEBA de Google: reemplázala en producción.
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
